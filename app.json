{
  "expo": {
    "name": "Hidder",
    "slug": "hidder",
    "scheme": "hidder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hidder.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Cho phép Hidder truy cập micro để ghi âm ghi chú thoại bí mật.",
        "NSCameraUsageDescription": "Cho phép Hidder sử dụng máy ảnh để chụp ảnh bí mật.",
        "NSPhotoLibraryUsageDescription": "Cho phép Hidder truy cập thư viện ảnh để mã hóa và lưu trữ bí mật.",
        "NSFaceIDUsageDescription": "Cho phép Hidder sử dụng Face ID để mở khóa kho lưu trữ bí mật."
      }
    },
    "android": {
      "package": "com.hidder.app",
      "versionCode": 7,
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#060A17"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.INTERNET",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "plugins": [
      [
        "./plugins/withDisguiseIcons",
        {
          "calculator": {
            "label": "Máy tính",
            "ios": "./assets/disguise-calculator.png",
            "android": {
              "foregroundImage": "./assets/disguise-calculator.png",
              "backgroundColor": "#FFFFFF"
            }
          },
          "notes": {
            "label": "Ghi chú",
            "ios": "./assets/disguise-notes.png",
            "android": {
              "foregroundImage": "./assets/disguise-notes.png",
              "backgroundColor": "#FFFFFF"
            }
          },
          "weather": {
            "label": "Thời tiết",
            "ios": "./assets/disguise-weather.png",
            "android": {
              "foregroundImage": "./assets/disguise-weather.png",
              "backgroundColor": "#FFFFFF"
            }
          },
          "calendar": {
            "label": "Lịch biểu",
            "ios": "./assets/disguise-calendar.png",
            "android": {
              "foregroundImage": "./assets/disguise-calendar.png",
              "backgroundColor": "#FFFFFF"
            }
          }
        }
      ],
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "Cho phép Hidder truy cập micro để ghi âm giọng nói bí mật."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép Hidder truy cập thư viện ảnh để mã hóa và lưu trữ bí mật.",
          "cameraPermission": "Cho phép Hidder sử dụng máy ảnh để chụp ảnh bí mật.",
          "microphonePermission": "Cho phép Hidder truy cập micro để quay video bí mật."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Cho phép Hidder sử dụng Face ID để mở khóa kho lưu trữ bí mật."
        }
      ],
      "expo-video",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#060A17"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "082857b6-f118-48de-a91b-c0bc485fdcab"
      }
    },
    "owner": "kaydenns-team"
  }
}
